# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, x):
#         self.val = x
#         self.next = None

class Solution:
    def hasCycle(self, head: Optional[ListNode]) -> bool:
        if not head or not head.next or head.next == None:
            return False
        while head.next != None and head.val != 'true':
            head.val = 'true'
            head = head.next
        if head.val == 'true':
            return True
        else:
            return False
