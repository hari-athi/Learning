# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def middleNode(self, head: Optional[ListNode]) -> Optional[ListNode]:
        dic={}
        leng=0
        while head:
            dic[leng]=head
            head=head.next
            leng+=1
        mid=leng//2
        return dic[mid]
